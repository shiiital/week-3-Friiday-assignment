<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <style>
    :root {
      --primary: #14b8a6; 
      --accent: #0f766e;    /
      --bg: #f0fdfa;        
      --text: #0f172a;      
      --radius: 12px;       
    }

    @media (prefers-color-scheme: dark) {
      :root {
        --primary: #0d9488;
        --accent: #2dd4bf;    
        --bg: #0f172a;        
        --text: #f0fdfa;      
        --radius: 12px;
      }
    }

    body {
      background: var(--bg);
      color: var(--text);
      font-family: sans-serif;
      padding: 20px;
    }

    .btn {
      background: var(--primary);
      color: white;
      border: none;
      border-radius: var(--radius);
      padding: 10px 20px;
      cursor: pointer;
    }

    .card {
      background: var(--bg);
      border: 2px solid var(--accent);
      border-radius: var(--radius);
      padding: 20px;
      margin-top: 16px;
      color: var(--text);
    }
  </style>
</head>
<body>
  <button class="btn">Click Me</button>
  <div class="card">A themed card using CSS variables</div>
</body>
</html>

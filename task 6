<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1.0">
  <style>
    :root {
      --primary: #14b8a6;
      --accent: #0f766e;
      --bg: #f0fdfa;
      --text: #0f172a;
      --radius: 12px;
    }

    @media (prefers-color-scheme: dark) {
      :root {
        --primary: #0d9488;
        --accent: #2dd4bf;
        --bg: #0f172a;
        --text: #f0fdfa;
        --radius: 12px;
      }
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background: var(--bg);
      color: var(--text);
      font-family: sans-serif;
      padding: 20px;
    }

    h1 {
      margin-bottom: 20px;
    }

    .grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 16px;
    }

    @media (min-width: 640px) {
      .grid {
        grid-template-columns: repeat(3, 1fr);
      }
    }

    .card {
      border: 2px solid var(--accent);
      border-radius: var(--radius);
      padding: 20px;
      background: var(--bg);
      transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .card:hover {
      transform: translateY(-6px);
      box-shadow: 0 8px 20px rgba(20, 184, 166, 0.3);
    }

    .card[data-icon]::before {
      content: attr(data-icon) '  ';
      font-size: 2rem;
      display: block;
      margin-bottom: 8px;
    }
  </style>
</head>
<body>
  <h1>My Skills</h1>
  <div class="grid">
    <div class="card" data-icon="🌐">HTML5 — Structure</div>
    <div class="card" data-icon="🎨">CSS3 — Styling</div>
    <div class="card" data-icon="⚡">JavaScript — Behaviour</div>
    <div class="card" data-icon="📐">Flexbox — 1D Layout</div>
    <div class="card" data-icon="🗂">Grid — 2D Layout</div>
    <div class="card" data-icon="📱">Responsive — Any Screen</div>
  </div>
</body>
</html>
